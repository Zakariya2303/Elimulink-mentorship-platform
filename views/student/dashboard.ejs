<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">

<div class="dash-layout">

  <!-- ── SIDEBAR ─────────────────────────────── -->
  <aside class="dash-sidebar" id="sidebar">

    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/student/dashboard" class="sidebar-link active">
        <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
      </a>
      <a href="/student/mentors" class="sidebar-link">
        <i class="bi bi-people"></i><span>Find Mentors</span>
      </a>
      <a href="/student/recommendations" class="sidebar-link">
  <i class="bi bi-stars"></i><span>AI Recommendations</span>
  <span class="sidebar-badge" style="background:#f0a500;color:#0d3b2e;font-size:9px;">AI</span>
</a>
      <a href="/student/requests" class="sidebar-link">
        <i class="bi bi-send"></i><span>My Requests</span>
      </a>
      <a href="/student/sessions" class="sidebar-link">
        <i class="bi bi-calendar2-check"></i><span>My Sessions</span>
      </a>
      <a href="/student/messages" class="sidebar-link">
        <i class="bi bi-chat-dots"></i><span>Messages</span>
        <% if (stats.unreadMessages > 0) { %>
          <span class="sidebar-badge"><%= stats.unreadMessages %></span>
        <% } %>
      </a>
      <a href="/student/resources" class="sidebar-link">
        <i class="bi bi-folder2-open"></i><span>Resources</span>
      </a>
    </nav>

    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/student/profile" class="sidebar-link">
        <i class="bi bi-person-circle"></i><span>My Profile</span>
      </a>
      <a href="/auth/logout" class="sidebar-link sidebar-danger">
        <i class="bi bi-box-arrow-left"></i><span>Log Out</span>
      </a>
    </nav>

    <div class="sidebar-user">
      <div class="sidebar-avatar">
        <%= user.full_name.charAt(0).toUpperCase() %>
      </div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Student</div>
      </div>
    </div>

  </aside>

  <!-- Mobile overlay -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- ── MAIN ─────────────────────────────────── -->
  <main class="dash-main">

    <!-- Topbar -->
    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen">
          <i class="bi bi-list"></i>
        </button>
        <div>
          <h5 class="topbar-title mb-0">My Dashboard</h5>
          <p class="topbar-sub mb-0">
            Welcome back, <strong><%= user.full_name.split(' ')[0] %></strong> 👋
          </p>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/student/messages" class="topbar-icon-btn">
          <i class="bi bi-bell"></i>
          <% if (stats.unreadMessages > 0) { %>
            <span class="topbar-dot"></span>
          <% } %>
        </a>
        <div class="topbar-user-chip">
          <div class="topbar-avatar">
            <%= user.full_name.charAt(0).toUpperCase() %>
          </div>
          <span class="d-none d-md-inline">
            <%= user.full_name.split(' ')[0] %>
          </span>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="dash-content">

      <!-- STAT CARDS -->
      <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
          <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-calendar2-check"></i></div>
            <div class="stat-value"><%= stats.upcomingSessions %></div>
            <div class="stat-label">Upcoming Sessions</div>
          </div>
        </div>

        <div class="col-6 col-xl-3">
          <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div class="stat-value"><%= stats.activeMentors %></div>
            <div class="stat-label">Active Mentors</div>
          </div>
        </div>

        <div class="col-6 col-xl-3">
          <div class="stat-card stat-gold">
            <div class="stat-icon"><i class="bi bi-chat-dots-fill"></i></div>
            <div class="stat-value"><%= stats.unreadMessages %></div>
            <div class="stat-label">Unread Messages</div>
          </div>
        </div>

        <div class="col-6 col-xl-3">
          <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="bi bi-folder2-open"></i></div>
            <div class="stat-value"><%= stats.totalResources %></div>
            <div class="stat-label">Resources Available</div>
          </div>
        </div>

      </div>

      <!-- QUICK ACTIONS -->
      <div class="dash-card mb-4">
        <div class="dash-card-head">
          <h6 class="dash-card-title">Quick Actions</h6>
        </div>
        <div class="quick-actions">
          <a href="/student/mentors" class="qa-btn">
            <i class="bi bi-search"></i><span>Find a Mentor</span>
          </a>
          <a href="/student/sessions" class="qa-btn">
            <i class="bi bi-calendar-plus"></i><span>View Sessions</span>
          </a>
          <a href="/student/resources" class="qa-btn">
            <i class="bi bi-download"></i><span>Get Resources</span>
          </a>
          <a href="/student/profile" class="qa-btn">
            <i class="bi bi-pencil-square"></i><span>Edit Profile</span>
          </a>
        </div>
      </div>

      <div class="row g-4">

        <!-- REQUESTS TABLE -->
        <div class="col-lg-7">
          <div class="dash-card h-100">
            <div class="dash-card-head">
              <h6 class="dash-card-title">My Mentorship Requests</h6>
              <a href="/student/requests" class="dash-card-more">View all</a>
            </div>

            <% if (requests.length === 0) { %>
              <div class="empty-state">
                <i class="bi bi-send"></i>
                <p>You haven't sent any requests yet.</p>
                <a href="/student/mentors" class="btn btn-primary-custom btn-sm px-4">
                  Find a Mentor
                </a>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="dash-table">
                  <thead>
                    <tr>
                      <th>Mentor</th>
                      <th>Company</th>
                      <th>Status</th>
                      <th>Sent</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% requests.forEach(function(r) { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <div class="tbl-avatar">
                              <%= r.mentor_name.charAt(0) %>
                            </div>
                            <span class="fw-semibold"><%= r.mentor_name %></span>
                          </div>
                        </td>
                        <td class="text-muted small">
                          <%= r.company || r.industry || '—' %>
                        </td>
                        <td>
                          <span class="badge-status badge-<%= r.status %>">
                            <%= r.status.charAt(0).toUpperCase() + r.status.slice(1) %>
                          </span>
                        </td>
                        <td class="text-muted small">
                          <%= new Date(r.created_at).toLocaleDateString('en-GB',
                              { day:'numeric', month:'short', year:'numeric' }) %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>

        <!-- UPCOMING SESSIONS -->
        <div class="col-lg-5">
          <div class="dash-card h-100">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Upcoming Sessions</h6>
              <a href="/student/sessions" class="dash-card-more">View all</a>
            </div>

            <% if (sessions.length === 0) { %>
              <div class="empty-state">
                <i class="bi bi-calendar2"></i>
                <p>No upcoming sessions yet.</p>
              </div>
            <% } else { %>
              <div class="session-list">
                <% sessions.forEach(function(s) { %>
                  <div class="session-item">
                    <div class="session-date-box">
                      <div class="session-day">
                        <%= new Date(s.session_date).toLocaleDateString('en-GB',
                            { day: 'numeric' }) %>
                      </div>
                      <div class="session-mon">
                        <%= new Date(s.session_date).toLocaleDateString('en-GB',
                            { month: 'short' }) %>
                      </div>
                    </div>
                    <div class="session-details">
                      <div class="session-name"><%= s.mentor_name %></div>
                      <div class="session-topic">
                        <%= s.topic || 'General Mentorship' %>
                      </div>
                      <div class="session-time">
                        <i class="bi bi-clock me-1"></i>
                        <%= s.session_time
                              ? s.session_time.toString().slice(0,5)
                              : 'TBD' %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

          </div>
        </div>

      </div>
    </div>
  </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>