<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
<div class="dash-layout">

  <aside class="dash-sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/student/dashboard" class="sidebar-link"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
      <a href="/student/mentors"   class="sidebar-link"><i class="bi bi-people"></i><span>Find Mentors</span></a>
      <a href="/student/recommendations" class="sidebar-link">
  <i class="bi bi-stars"></i><span>AI Recommendations</span>
  <span class="sidebar-badge" style="background:#f0a500;color:#0d3b2e;font-size:9px;">AI</span>
</a>
      <a href="/student/requests"  class="sidebar-link"><i class="bi bi-send"></i><span>My Requests</span></a>
      <a href="/student/sessions"  class="sidebar-link"><i class="bi bi-calendar2-check"></i><span>My Sessions</span></a>
      <a href="/student/resources" class="sidebar-link active"><i class="bi bi-folder2-open"></i><span>Resources</span></a>
    </nav>
    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/student/profile" class="sidebar-link"><i class="bi bi-person-circle"></i><span>My Profile</span></a>
      <a href="/auth/logout"     class="sidebar-link sidebar-danger"><i class="bi bi-box-arrow-left"></i><span>Log Out</span></a>
    </nav>
    <div class="sidebar-user">
      <div class="sidebar-avatar"><%= user.full_name.charAt(0).toUpperCase() %></div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Student</div>
      </div>
    </div>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <main class="dash-main">
    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen"><i class="bi bi-list"></i></button>
        <div>
          <h5 class="topbar-title mb-0">Career Resources</h5>
          <p class="topbar-sub mb-0">Free guides and templates shared by mentors</p>
        </div>
      </div>
    </div>

    <div class="dash-content">
      <% if (resources.length === 0) { %>
        <div class="dash-card">
          <div class="empty-state py-5">
            <i class="bi bi-folder2-open"></i>
            <p>No resources have been uploaded yet. Check back soon.</p>
          </div>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% resources.forEach(function(r) { %>
            <div class="col-md-6 col-xl-4">
              <div class="resource-card">
                <div class="resource-icon-wrap">
                  <% if (r.category === 'cv') { %>
                    <i class="bi bi-file-person"></i>
                  <% } else if (r.category === 'interview') { %>
                    <i class="bi bi-chat-quote"></i>
                  <% } else if (r.category === 'industry') { %>
                    <i class="bi bi-graph-up"></i>
                  <% } else if (r.category === 'networking') { %>
                    <i class="bi bi-diagram-3"></i>
                  <% } else { %>
                    <i class="bi bi-file-earmark-text"></i>
                  <% } %>
                </div>
                <div class="resource-body">
                  <span class="resource-category"><%= r.category.toUpperCase() %></span>
                  <h6 class="resource-title"><%= r.title %></h6>
                  <% if (r.description) { %>
                    <p class="resource-desc"><%= r.description %></p>
                  <% } %>
                  <div class="resource-meta">
                    <span><i class="bi bi-person me-1"></i><%= r.uploaded_by_name || 'ElimuLink' %></span>
                    <span><i class="bi bi-calendar me-1"></i>
                      <%= new Date(r.created_at).toLocaleDateString('en-GB',
                          { day:'numeric', month:'short', year:'numeric' }) %>
                    </span>
                  </div>
                </div>
                <% if (r.file_url) { %>
                  <a href="<%= r.file_url %>" target="_blank" class="resource-download">
                    <i class="bi bi-download me-1"></i> Download
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>