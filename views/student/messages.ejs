<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
<div class="dash-layout">

  <!-- SIDEBAR -->
  <aside class="dash-sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/student/dashboard" class="sidebar-link">
        <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
      </a>
      <a href="/student/mentors" class="sidebar-link">
        <i class="bi bi-people"></i><span>Find Mentors</span>
      </a>
      <a href="/student/recommendations" class="sidebar-link">
  <i class="bi bi-stars"></i><span>AI Recommendations</span>
  <span class="sidebar-badge" style="background:#f0a500;color:#0d3b2e;font-size:9px;">AI</span>
</a>
      <a href="/student/requests" class="sidebar-link">
        <i class="bi bi-send"></i><span>My Requests</span>
      </a>
      <a href="/student/sessions" class="sidebar-link">
        <i class="bi bi-calendar2-check"></i><span>My Sessions</span>
      </a>
      <a href="/student/messages" class="sidebar-link active">
        <i class="bi bi-chat-dots"></i><span>Messages</span>
        <% if (typeof stats !== 'undefined' && stats.unreadMessages > 0) { %>
          <span class="sidebar-badge"><%= stats.unreadMessages %></span>
        <% } %>
      </a>
      <a href="/student/resources" class="sidebar-link">
        <i class="bi bi-folder2-open"></i><span>Resources</span>
      </a>
    </nav>

    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/student/profile" class="sidebar-link">
        <i class="bi bi-person-circle"></i><span>My Profile</span>
      </a>
      <a href="/auth/logout" class="sidebar-link sidebar-danger">
        <i class="bi bi-box-arrow-left"></i><span>Log Out</span>
      </a>
    </nav>

    <div class="sidebar-user">
      <div class="sidebar-avatar">
        <%= user.full_name.charAt(0).toUpperCase() %>
      </div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Student</div>
      </div>
    </div>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- MAIN -->
  <main class="dash-main">

    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen">
          <i class="bi bi-list"></i>
        </button>
        <div>
          <h5 class="topbar-title mb-0">Messages</h5>
          <p class="topbar-sub mb-0">Your conversations with mentors</p>
        </div>
      </div>
      <div class="topbar-right">
        <div class="topbar-user-chip">
          <div class="topbar-avatar">
            <%= user.full_name.charAt(0).toUpperCase() %>
          </div>
          <span class="d-none d-md-inline">
            <%= user.full_name.split(' ')[0] %>
          </span>
        </div>
      </div>
    </div>

    <div class="dash-content">
      <div class="row g-4" style="height: calc(100vh - 140px);">

        <!-- LEFT — Conversations List -->
        <div class="col-md-4">
          <div class="dash-card h-100" style="overflow-y: auto;">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Conversations</h6>
              <span class="text-muted small">
                <%= conversations.length %> total
              </span>
            </div>

            <% if (conversations.length === 0) { %>
              <div class="empty-state py-4">
                <i class="bi bi-chat-dots"></i>
                <p>No conversations yet. Send a mentorship request to start messaging a mentor.</p>
                <a href="/student/mentors" class="btn btn-primary-custom btn-sm px-4">
                  Find a Mentor
                </a>
              </div>
            <% } else { %>
              <div class="convo-list">
                <% conversations.forEach(function(c) { %>
                  <a href="/student/messages/<%= c.other_id %>"
                     class="convo-item <%= activeId == c.other_id ? 'active' : '' %>">
                    <div class="convo-avatar">
                      <%= c.other_name.charAt(0).toUpperCase() %>
                    </div>
                    <div class="convo-info">
                      <div class="convo-name"><%= c.other_name %></div>
                      <div class="convo-preview">
                        <%= c.last_message ? c.last_message.substring(0, 40) + '...' : 'No messages yet' %>
                      </div>
                    </div>
                    <% if (c.unread > 0) { %>
                      <span class="convo-unread"><%= c.unread %></span>
                    <% } %>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- RIGHT — Chat Area -->
        <div class="col-md-8">
          <div class="dash-card h-100 d-flex flex-column">

            <% if (!activeId) { %>
              <div class="empty-state my-auto">
                <i class="bi bi-chat-dots" style="font-size:48px; opacity:0.15;"></i>
                <p class="mt-3 text-muted">Select a conversation on the left to start messaging.</p>
              </div>

            <% } else { %>

              <!-- Chat header -->
              <div class="dash-card-head">
                <div class="d-flex align-items-center gap-3">
                  <div class="convo-avatar" style="width:36px; height:36px; font-size:14px;">
                    <%= activeName.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <h6 class="dash-card-title mb-0"><%= activeName %></h6>
                    <span class="text-muted" style="font-size:12px;">Mentor</span>
                  </div>
                </div>
              </div>

              <!-- Messages -->
              <div class="chat-messages" id="chatMessages">
                <% if (messages.length === 0) { %>
                  <div class="text-center text-muted py-4" style="font-size:14px;">
                    No messages yet. Say hello!
                  </div>
                <% } else { %>
                  <% messages.forEach(function(m) { %>
                    <div class="chat-bubble <%= m.sender_id === user.id ? 'sent' : 'received' %>">
                      <div class="bubble-text"><%= m.content %></div>
                      <div class="bubble-time">
                        <%= new Date(m.created_at).toLocaleTimeString('en-GB',
                            { hour: '2-digit', minute: '2-digit' }) %>
                        &nbsp;
                        <%= new Date(m.created_at).toLocaleDateString('en-GB',
                            { day: 'numeric', month: 'short' }) %>
                      </div>
                    </div>
                  <% }) %>
                <% } %>
              </div>

              <!-- Message input -->
              <form action="/student/messages/<%= activeId %>/send"
                    method="POST" class="chat-input-area">
                <input type="text" name="content"
                       class="form-control custom-input"
                       placeholder="Type your message here..."
                       style="padding-left: 14px;"
                       required autocomplete="off">
                <button type="submit" class="chat-send-btn">
                  <i class="bi bi-send-fill"></i>
                </button>
              </form>

            <% } %>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
  // Auto scroll chat to bottom when page loads
  const chatBox = document.getElementById('chatMessages');
  if (chatBox) {
    chatBox.scrollTop = chatBox.scrollHeight;
  }
</script>
</body>
</html>