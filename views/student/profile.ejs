<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
<div class="dash-layout">

  <aside class="dash-sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/student/dashboard" class="sidebar-link"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
      <a href="/student/mentors"   class="sidebar-link"><i class="bi bi-people"></i><span>Find Mentors</span></a>
      <a href="/student/recommendations" class="sidebar-link">
  <i class="bi bi-stars"></i><span>AI Recommendations</span>
  <span class="sidebar-badge" style="background:#f0a500;color:#0d3b2e;font-size:9px;">AI</span>
</a>
      <a href="/student/requests"  class="sidebar-link"><i class="bi bi-send"></i><span>My Requests</span></a>
      <a href="/student/sessions"  class="sidebar-link"><i class="bi bi-calendar2-check"></i><span>My Sessions</span></a>
      <a href="/student/resources" class="sidebar-link"><i class="bi bi-folder2-open"></i><span>Resources</span></a>
    </nav>
    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/student/profile" class="sidebar-link active"><i class="bi bi-person-circle"></i><span>My Profile</span></a>
      <a href="/auth/logout"     class="sidebar-link sidebar-danger"><i class="bi bi-box-arrow-left"></i><span>Log Out</span></a>
    </nav>
    <div class="sidebar-user">
      <div class="sidebar-avatar"><%= user.full_name.charAt(0).toUpperCase() %></div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Student</div>
      </div>
    </div>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <main class="dash-main">
    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen"><i class="bi bi-list"></i></button>
        <div>
          <h5 class="topbar-title mb-0">My Profile</h5>
          <p class="topbar-sub mb-0">Keep your profile up to date for better mentor matches</p>
        </div>
      </div>
    </div>

    <div class="dash-content">
      <div class="row g-4">

        <!-- Profile summary card -->
        <div class="col-lg-4">
          <div class="dash-card p-4 text-center">
            <div class="profile-avatar-lg mx-auto mb-3">
              <%= userData.full_name.charAt(0).toUpperCase() %>
            </div>
            <h5 class="fw-bold mb-1"><%= userData.full_name %></h5>
            <p class="text-muted small mb-2"><%= userData.email %></p>
            <span class="badge-status badge-student mb-3 d-inline-block">Student</span>
            <% if (userData.university) { %>
              <p class="text-muted small mb-0">
                <i class="bi bi-building me-1"></i><%= userData.university %>
              </p>
            <% } %>
            <% if (profile.course) { %>
              <p class="text-muted small mb-0">
                <i class="bi bi-book me-1"></i><%= profile.course %>
              </p>
            <% } %>
          </div>
        </div>

        <!-- Edit form -->
        <div class="col-lg-8">
          <div class="dash-card">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Edit Your Information</h6>
            </div>
            <div class="p-4">
              <form action="/student/profile" method="POST">

                <div class="row g-3">
                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Full Name</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-person input-icon"></i>
                        <input type="text" name="full_name" class="form-control custom-input"
                               value="<%= userData.full_name %>" required>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>University</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-building input-icon"></i>
                        <select name="university" class="form-control custom-input">
                          <option value="">Select university</option>
                          <% ['University of Nairobi','Kenyatta University','Strathmore University','USIU-Africa','Other'].forEach(function(u) { %>
                            <option value="<%= u %>" <%= userData.university === u ? 'selected' : '' %>><%= u %></option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Course / Degree</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-book input-icon"></i>
                        <input type="text" name="course" class="form-control custom-input"
                               placeholder="e.g. BSc Computer Science"
                               value="<%= profile.course || '' %>">
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Year of Study</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-123 input-icon"></i>
                        <select name="year_of_study" class="form-control custom-input">
                          <option value="">Select year</option>
                          <% [1,2,3,4,5].forEach(function(y) { %>
                            <option value="<%= y %>" <%= profile.year_of_study == y ? 'selected' : '' %>>
                              Year <%= y %>
                            </option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="form-group-custom">
                      <label>Career Interests</label>
                      <textarea name="career_interests" rows="3"
                                class="form-control custom-input" style="padding-left:14px;"
                                placeholder="e.g. Software Engineering, FinTech, Data Science..."><%= profile.career_interests || '' %></textarea>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="form-group-custom">
                      <label>Short Bio</label>
                      <textarea name="bio" rows="3"
                                class="form-control custom-input" style="padding-left:14px;"
                                placeholder="Tell mentors a little about yourself..."><%= userData.bio || '' %></textarea>
                    </div>
                  </div>

                  <div class="col-12">
                    <button type="submit" class="btn btn-primary-custom px-5">
                      <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                  </div>
                </div>

              </form>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>