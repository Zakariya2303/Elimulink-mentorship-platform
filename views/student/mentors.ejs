<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
<div class="dash-layout">

  <!-- SIDEBAR -->
  <aside class="dash-sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/student/dashboard" class="sidebar-link">
        <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
      </a>
      <a href="/student/mentors" class="sidebar-link active">
        <i class="bi bi-people"></i><span>Find Mentors</span>
      </a>
      <a href="/student/recommendations" class="sidebar-link">
  <i class="bi bi-stars"></i><span>AI Recommendations</span>
  <span class="sidebar-badge" style="background:#f0a500;color:#0d3b2e;font-size:9px;">AI</span>
</a>
      <a href="/student/requests" class="sidebar-link">
        <i class="bi bi-send"></i><span>My Requests</span>
      </a>
      <a href="/student/sessions" class="sidebar-link">
        <i class="bi bi-calendar2-check"></i><span>My Sessions</span>
      </a>
      <a href="/student/resources" class="sidebar-link">
        <i class="bi bi-folder2-open"></i><span>Resources</span>
      </a>
    </nav>

    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/student/profile" class="sidebar-link">
        <i class="bi bi-person-circle"></i><span>My Profile</span>
      </a>
      <a href="/auth/logout" class="sidebar-link sidebar-danger">
        <i class="bi bi-box-arrow-left"></i><span>Log Out</span>
      </a>
    </nav>

    <div class="sidebar-user">
      <div class="sidebar-avatar">
        <%= user.full_name.charAt(0).toUpperCase() %>
      </div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Student</div>
      </div>
    </div>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- MAIN -->
  <main class="dash-main">

    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen">
          <i class="bi bi-list"></i>
        </button>
        <div>
          <h5 class="topbar-title mb-0">Find a Mentor</h5>
          <p class="topbar-sub mb-0">Browse professionals ready to guide you</p>
        </div>
      </div>
      <div class="topbar-right">
        <div class="topbar-user-chip">
          <div class="topbar-avatar">
            <%= user.full_name.charAt(0).toUpperCase() %>
          </div>
          <span class="d-none d-md-inline"><%= user.full_name.split(' ')[0] %></span>
        </div>
      </div>
    </div>

    <div class="dash-content">

      <!-- SEARCH AND FILTER -->
      <div class="dash-card mb-4">
        <div class="p-4">
          <form method="GET" action="/student/mentors">
            <div class="row g-3">
              <div class="col-md-6">
                <div class="input-icon-wrap">
                  <i class="bi bi-search input-icon"></i>
                  <input type="text" name="search"
                         class="form-control custom-input"
                         placeholder="Search by name, job title or company..."
                         value="<%= search %>">
                </div>
              </div>
              <div class="col-md-4">
                <div class="input-icon-wrap">
                  <i class="bi bi-briefcase input-icon"></i>
                  <select name="industry" class="form-control custom-input">
                    <option value="">All Industries</option>
                    <% industries.forEach(function(ind) { %>
                      <option value="<%= ind %>"
                        <%= selectedIndustry === ind ? 'selected' : '' %>>
                        <%= ind %>
                      </option>
                    <% }) %>
                  </select>
                </div>
              </div>
              <div class="col-md-2">
                <button type="submit" class="btn btn-primary-custom w-100">
                  <i class="bi bi-funnel me-1"></i>Filter
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- RESULTS COUNT -->
      <p class="text-muted mb-3 small fw-semibold">
        Showing <strong><%= mentors.length %></strong>
        mentor<%= mentors.length !== 1 ? 's' : '' %>
        <% if (selectedIndustry) { %>
          in <strong><%= selectedIndustry %></strong>
        <% } %>
        <% if (search) { %>
          matching &ldquo;<strong><%= search %></strong>&rdquo;
        <% } %>
      </p>

      <!-- MENTOR CARDS -->
      <% if (mentors.length === 0) { %>
        <div class="dash-card">
          <div class="empty-state py-5">
            <i class="bi bi-people"></i>
            <p>No mentors found matching your search.</p>
            <a href="/student/mentors" class="btn btn-primary-custom px-4">
              Clear Filters
            </a>
          </div>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% mentors.forEach(function(mentor) { %>
            <div class="col-md-6 col-xl-4">
              <div class="mentor-card">

                <!-- Top -->
                <div class="mentor-card-top">
                  <div class="mentor-avatar">
                    <%= mentor.full_name.charAt(0).toUpperCase() %>
                  </div>
                  <div class="mentor-card-info">
                    <div class="mentor-card-name"><%= mentor.full_name %></div>
                    <div class="mentor-card-role">
                      <%= mentor.job_title || 'Professional' %>
                      <% if (mentor.company) { %>
                        &middot; <%= mentor.company %>
                      <% } %>
                    </div>
                    <% if (mentor.industry) { %>
                      <span class="mentor-industry-tag"><%= mentor.industry %></span>
                    <% } %>
                  </div>
                </div>

                <!-- Body -->
                <div class="mentor-card-body">
                  <% if (mentor.expertise) { %>
                    <p class="mentor-expertise">
                      <i class="bi bi-lightning-charge me-1"></i>
                      <%= mentor.expertise.length > 100
                            ? mentor.expertise.substring(0, 100) + '...'
                            : mentor.expertise %>
                    </p>
                  <% } %>
                  <div class="mentor-meta">
                    <% if (mentor.university) { %>
                      <span>
                        <i class="bi bi-building me-1"></i><%= mentor.university %>
                      </span>
                    <% } %>
                    <% if (mentor.years_experience) { %>
                      <span>
                        <i class="bi bi-briefcase me-1"></i>
                        <%= mentor.years_experience %> yrs exp
                      </span>
                    <% } %>
                  </div>
                </div>

                <!-- Footer — THIS IS THE FIXED PART -->
                <div class="mentor-card-footer">
                  <% if (alreadySent.includes(mentor.id)) { %>
                    <button class="btn-request-sent" disabled>
                      <i class="bi bi-check-circle me-1"></i>Request Sent
                    </button>
                  <% } else { %>
                    <button class="btn-request"
                            data-mentor-id="<%= mentor.id %>"
                            data-mentor-name="<%= mentor.full_name %>"
                            onclick="openRequestModal(this)">
                      <i class="bi bi-send me-1"></i>Send Request
                    </button>
                  <% } %>
                </div>

              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

    </div>
  </main>
</div>

<!-- REQUEST MODAL -->
<div class="modal fade" id="requestModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:16px; border:none;">

      <div class="modal-header"
           style="border-bottom:1px solid #e2e8f0; padding:20px 24px;">
        <h5 class="modal-title fw-bold" id="modalTitle">Send Mentorship Request</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <form id="requestForm" method="POST" action="">
        <div class="modal-body" style="padding:24px;">
          <p class="text-muted small mb-3">
            Introduce yourself and tell
            <span id="mentorNameSpan" class="fw-semibold"></span>
            what kind of guidance you are looking for.
          </p>
          <div class="form-group-custom">
            <label>Your Message</label>
            <textarea name="message" rows="5"
                      class="form-control custom-input"
                      style="padding-left:14px;"
                      placeholder="Hi, I am a final year Computer Science student at the University of Nairobi. I would love to get your guidance on how to break into the industry..."></textarea>
          </div>
        </div>
        <div class="modal-footer"
             style="border-top:1px solid #e2e8f0; padding:16px 24px;">
          <button type="button" class="btn btn-nav-outline"
                  data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom px-4">
            <i class="bi bi-send me-1"></i>Send Request
          </button>
        </div>
      </form>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
  function openRequestModal(button) {
    var mentorId   = button.getAttribute('data-mentor-id');
    var mentorName = button.getAttribute('data-mentor-name');

    document.getElementById('requestForm').action =
      '/student/mentors/request/' + mentorId;

    document.getElementById('mentorNameSpan').textContent = mentorName;
    document.getElementById('modalTitle').textContent =
      'Request Mentorship from ' + mentorName;

    new bootstrap.Modal(document.getElementById('requestModal')).show();
  }
</script>

</body>
</html>