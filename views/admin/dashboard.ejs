<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">

<div class="dash-layout">

  <!-- SIDEBAR -->
  <aside class="dash-sidebar sidebar-admin" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="sidebar-label">Administration</div>
    <nav class="sidebar-nav">
      <a href="/admin/dashboard" class="sidebar-link active">
        <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
      </a>
      <a href="/admin/users" class="sidebar-link">
        <i class="bi bi-people"></i><span>Manage Users</span>
      </a>
      <a href="/admin/sessions" class="sidebar-link">
        <i class="bi bi-calendar2-check"></i><span>All Sessions</span>
      </a>
      <a href="/admin/resources" class="sidebar-link">
        <i class="bi bi-folder2-open"></i><span>Resources</span>
      </a>
    </nav>

    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/auth/logout" class="sidebar-link sidebar-danger">
        <i class="bi bi-box-arrow-left"></i><span>Log Out</span>
      </a>
    </nav>

    <div class="sidebar-user">
      <div class="sidebar-avatar sidebar-avatar-admin">
        <i class="bi bi-shield-fill-check"></i>
      </div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Administrator</div>
      </div>
    </div>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- MAIN -->
  <main class="dash-main">

    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen">
          <i class="bi bi-list"></i>
        </button>
        <div>
          <h5 class="topbar-title mb-0">Admin Dashboard</h5>
          <p class="topbar-sub mb-0">Platform overview and management</p>
        </div>
      </div>
      <div class="topbar-right">
        <div class="topbar-user-chip">
          <div class="topbar-avatar topbar-avatar-admin">
            <i class="bi bi-shield-fill"></i>
          </div>
          <span class="d-none d-md-inline">Admin</span>
        </div>
      </div>
    </div>

    <div class="dash-content">

      <!-- STATS -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
          <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div class="stat-value"><%= stats.totalUsers %></div>
            <div class="stat-label">Total Users</div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-mortarboard-fill"></i></div>
            <div class="stat-value"><%= stats.totalStudents %></div>
            <div class="stat-label">Students</div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="stat-card stat-gold">
            <div class="stat-icon"><i class="bi bi-briefcase-fill"></i></div>
            <div class="stat-value"><%= stats.totalMentors %></div>
            <div class="stat-label">Mentors</div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="bi bi-calendar2-check-fill"></i></div>
            <div class="stat-value"><%= stats.totalSessions %></div>
            <div class="stat-label">Total Sessions</div>
          </div>
        </div>
      </div>

      <div class="row g-4">

        <!-- RECENT USERS -->
        <div class="col-lg-7">
          <div class="dash-card h-100">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Recently Joined Users</h6>
              <a href="/admin/users" class="dash-card-more">View all</a>
            </div>
            <div class="table-responsive">
              <table class="dash-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Joined</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentUsers.length === 0) { %>
                    <tr><td colspan="4" class="text-center text-muted py-4">No users yet.</td></tr>
                  <% } else { %>
                    <% recentUsers.forEach(function(u) { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <div class="tbl-avatar">
                              <%= u.full_name.charAt(0) %>
                            </div>
                            <span class="fw-semibold"><%= u.full_name %></span>
                          </div>
                        </td>
                        <td class="text-muted small"><%= u.email %></td>
                        <td>
                          <span class="badge-status badge-<%= u.role %>">
                            <%= u.role.charAt(0).toUpperCase() + u.role.slice(1) %>
                          </span>
                        </td>
                        <td class="text-muted small">
                          <%= new Date(u.created_at).toLocaleDateString('en-GB',
                              { day:'numeric', month:'short', year:'numeric' }) %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- RECENT SESSIONS -->
        <div class="col-lg-5">
          <div class="dash-card h-100">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Recent Sessions</h6>
              <a href="/admin/sessions" class="dash-card-more">View all</a>
            </div>

            <% if (recentSessions.length === 0) { %>
              <div class="empty-state">
                <i class="bi bi-calendar2"></i>
                <p>No sessions have been booked yet.</p>
              </div>
            <% } else { %>
              <div class="session-list">
                <% recentSessions.forEach(function(s) { %>
                  <div class="session-item">
                    <div class="session-date-box">
                      <div class="session-day">
                        <%= new Date(s.session_date).toLocaleDateString('en-GB',{day:'numeric'}) %>
                      </div>
                      <div class="session-mon">
                        <%= new Date(s.session_date).toLocaleDateString('en-GB',{month:'short'}) %>
                      </div>
                    </div>
                    <div class="session-details">
                      <div class="session-name"><%= s.student_name %></div>
                      <div class="session-topic text-muted">
                        with <%= s.mentor_name %>
                      </div>
                      <span class="badge-status badge-<%= s.status %>">
                        <%= s.status.charAt(0).toUpperCase() + s.status.slice(1) %>
                      </span>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>