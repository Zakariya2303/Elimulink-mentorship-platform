<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
<div class="dash-layout">
  <aside class="dash-sidebar sidebar-admin" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="sidebar-label">Administration</div>
    <nav class="sidebar-nav">
      <a href="/admin/dashboard"  class="sidebar-link"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
      <a href="/admin/users"      class="sidebar-link"><i class="bi bi-people"></i><span>Manage Users</span></a>
      <a href="/admin/sessions"   class="sidebar-link"><i class="bi bi-calendar2-check"></i><span>All Sessions</span></a>
      <a href="/admin/resources"  class="sidebar-link active"><i class="bi bi-folder2-open"></i><span>Resources</span></a>
    </nav>
    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/auth/logout" class="sidebar-link sidebar-danger"><i class="bi bi-box-arrow-left"></i><span>Log Out</span></a>
    </nav>
    <div class="sidebar-user">
      <div class="sidebar-avatar sidebar-avatar-admin"><i class="bi bi-shield-fill-check"></i></div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Administrator</div>
      </div>
    </div>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <main class="dash-main">
    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen"><i class="bi bi-list"></i></button>
        <div>
          <h5 class="topbar-title mb-0">Resources</h5>
          <p class="topbar-sub mb-0">All career resources on the platform</p>
        </div>
      </div>
    </div>
    <div class="dash-content">
      <div class="dash-card">
        <div class="dash-card-head">
          <h6 class="dash-card-title">All Resources</h6>
          <span class="text-muted small"><%= resources.length %> total</span>
        </div>
        <div class="table-responsive">
          <table class="dash-table">
            <thead>
              <tr><th>Title</th><th>Category</th><th>Uploaded By</th><th>Date</th><th>Action</th></tr>
            </thead>
            <tbody>
              <% if (resources.length === 0) { %>
                <tr><td colspan="5" class="text-center text-muted py-4">No resources yet.</td></tr>
              <% } else { %>
                <% resources.forEach(function(r) { %>
                  <tr>
                    <td><span class="fw-semibold"><%= r.title %></span></td>
                    <td>
                      <span class="badge-status badge-upcoming">
                        <%= r.category.toUpperCase() %>
                      </span>
                    </td>
                    <td class="text-muted small"><%= r.uploaded_by_name || 'ElimuLink' %></td>
                    <td class="text-muted small">
                      <%= new Date(r.created_at).toLocaleDateString('en-GB',
                          { day:'numeric', month:'short', year:'numeric' }) %>
                    </td>
                    <td>
                      <form action="/admin/resources/<%= r.id %>/delete" method="POST"
                            onsubmit="return confirm('Delete this resource?')">
                        <button type="submit" class="btn-action btn-decline btn-sm">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>