<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
<div class="dash-layout">

  <aside class="dash-sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/mentor/dashboard"  class="sidebar-link"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
      <a href="/mentor/requests"   class="sidebar-link active"><i class="bi bi-inbox"></i><span>Requests</span></a>
      <a href="/mentor/sessions"   class="sidebar-link"><i class="bi bi-calendar2-check"></i><span>My Sessions</span></a>
      <a href="/mentor/messages"   class="sidebar-link"><i class="bi bi-chat-dots"></i><span>Messages</span></a>
      <a href="/mentor/resources"  class="sidebar-link"><i class="bi bi-folder2-open"></i><span>Resources</span></a>
    </nav>
    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/mentor/profile"  class="sidebar-link"><i class="bi bi-person-circle"></i><span>My Profile</span></a>
      <a href="/auth/logout"     class="sidebar-link sidebar-danger"><i class="bi bi-box-arrow-left"></i><span>Log Out</span></a>
    </nav>
    <div class="sidebar-user">
      <div class="sidebar-avatar sidebar-avatar-mentor">
        <%= user.full_name.charAt(0).toUpperCase() %>
      </div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Mentor</div>
      </div>
    </div>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <main class="dash-main">
    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen">
          <i class="bi bi-list"></i>
        </button>
        <div>
          <h5 class="topbar-title mb-0">Book a Session</h5>
          <p class="topbar-sub mb-0">Schedule a mentorship session with <%= student.full_name %></p>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/mentor/requests" class="btn btn-nav-outline btn-sm px-3">
          <i class="bi bi-arrow-left me-1"></i>Back to Requests
        </a>
      </div>
    </div>

    <div class="dash-content">
      <div class="row g-4 justify-content-center">
        <div class="col-lg-7">

          <!-- Student info card -->
          <div class="dash-card mb-4">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Booking Session With</h6>
            </div>
            <div class="p-4 d-flex align-items-center gap-3">
              <div class="profile-avatar-lg" style="width:52px;height:52px;font-size:20px;">
                <%= student.full_name.charAt(0).toUpperCase() %>
              </div>
              <div>
                <div class="fw-bold" style="font-size:16px;"><%= student.full_name %></div>
                <div class="text-muted small"><%= student.email %></div>
                <% if (student.course) { %>
                  <div class="text-muted small">
                    <i class="bi bi-book me-1"></i><%= student.course %>
                  </div>
                <% } %>
                <% if (student.university) { %>
                  <div class="text-muted small">
                    <i class="bi bi-building me-1"></i><%= student.university %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Booking form -->
          <div class="dash-card">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Session Details</h6>
            </div>
            <div class="p-4">
              <form action="/mentor/sessions/book/<%= student.id %>" method="POST">
                <div class="row g-3">

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Session Date</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-calendar3 input-icon"></i>
                        <input type="date" name="session_date"
                               class="form-control custom-input"
                               min="<%= new Date().toISOString().split('T')[0] %>"
                               required>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Session Time</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-clock input-icon"></i>
                        <input type="time" name="session_time"
                               class="form-control custom-input"
                               required>
                      </div>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="form-group-custom">
                      <label>Session Topic</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-chat-square-text input-icon"></i>
                        <input type="text" name="topic"
                               class="form-control custom-input"
                               placeholder="e.g. CV Review, Career Paths in Tech, Interview Preparation"
                               required>
                      </div>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="form-group-custom">
                      <label>Notes for the Student <span class="text-muted">(optional)</span></label>
                      <textarea name="notes" rows="4"
                                class="form-control custom-input"
                                style="padding-left:14px;"
                                placeholder="Any preparation notes or instructions for the student before the session..."></textarea>
                    </div>
                  </div>

                  <div class="col-12 d-flex gap-3 mt-2">
                    <button type="submit" class="btn btn-primary-custom px-5">
                      <i class="bi bi-calendar-check me-2"></i>Confirm Session
                    </button>
                    <a href="/mentor/requests" class="btn btn-nav-outline px-4">
                      Cancel
                    </a>
                  </div>

                </div>
              </form>
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>