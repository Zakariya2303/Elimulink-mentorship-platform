<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
<div class="dash-layout">

  <aside class="dash-sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/mentor/dashboard"  class="sidebar-link"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
      <a href="/mentor/requests"   class="sidebar-link"><i class="bi bi-inbox"></i><span>Requests</span></a>
      <a href="/mentor/sessions"   class="sidebar-link"><i class="bi bi-calendar2-check"></i><span>My Sessions</span></a>
      <a href="/mentor/messages"   class="sidebar-link"><i class="bi bi-chat-dots"></i><span>Messages</span></a>
      <a href="/mentor/resources"  class="sidebar-link active"><i class="bi bi-folder2-open"></i><span>Resources</span></a>
    </nav>
    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/mentor/profile"  class="sidebar-link"><i class="bi bi-person-circle"></i><span>My Profile</span></a>
      <a href="/auth/logout"     class="sidebar-link sidebar-danger"><i class="bi bi-box-arrow-left"></i><span>Log Out</span></a>
    </nav>
    <div class="sidebar-user">
      <div class="sidebar-avatar sidebar-avatar-mentor"><%= user.full_name.charAt(0).toUpperCase() %></div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Mentor</div>
      </div>
    </div>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <main class="dash-main">
    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen"><i class="bi bi-list"></i></button>
        <div>
          <h5 class="topbar-title mb-0">Career Resources</h5>
          <p class="topbar-sub mb-0">Share useful materials with students</p>
        </div>
      </div>
      <div class="topbar-right">
        <button class="btn btn-primary-custom btn-sm px-3"
                data-bs-toggle="modal" data-bs-target="#addResourceModal">
          <i class="bi bi-plus me-1"></i>Add Resource
        </button>
      </div>
    </div>

    <div class="dash-content">
      <% if (resources.length === 0) { %>
        <div class="dash-card">
          <div class="empty-state py-5">
            <i class="bi bi-folder2-open"></i>
            <p>No resources uploaded yet. Add the first one for your students.</p>
          </div>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% resources.forEach(function(r) { %>
            <div class="col-md-6 col-xl-4">
              <div class="resource-card">
                <div class="resource-icon-wrap">
                  <% if (r.category === 'cv') { %>
                    <i class="bi bi-file-person"></i>
                  <% } else if (r.category === 'interview') { %>
                    <i class="bi bi-chat-quote"></i>
                  <% } else if (r.category === 'industry') { %>
                    <i class="bi bi-graph-up"></i>
                  <% } else if (r.category === 'networking') { %>
                    <i class="bi bi-diagram-3"></i>
                  <% } else { %>
                    <i class="bi bi-file-earmark-text"></i>
                  <% } %>
                </div>
                <div class="resource-body">
                  <span class="resource-category"><%= r.category.toUpperCase() %></span>
                  <h6 class="resource-title"><%= r.title %></h6>
                  <% if (r.description) { %>
                    <p class="resource-desc"><%= r.description %></p>
                  <% } %>
                </div>
                <% if (r.file_url) { %>
                  <a href="<%= r.file_url %>" target="_blank" class="resource-download">
                    <i class="bi bi-download me-1"></i>Download
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</div>

<!-- ADD RESOURCE MODAL -->
<div class="modal fade" id="addResourceModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:16px; border:none;">
      <div class="modal-header" style="border-bottom:1px solid #e2e8f0; padding:20px 24px;">
        <h5 class="modal-title fw-bold">Add New Resource</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/mentor/resources/add" method="POST">
        <div class="modal-body" style="padding:24px;">
          <div class="form-group-custom">
            <label>Title</label>
            <input type="text" name="title" class="form-control custom-input"
                   style="padding-left:14px;" placeholder="e.g. How to Write a Tech CV" required>
          </div>
          <div class="form-group-custom">
            <label>Category</label>
            <select name="category" class="form-control custom-input" style="padding-left:14px;">
              <option value="cv">CV Writing</option>
              <option value="interview">Interview Prep</option>
              <option value="industry">Industry Overview</option>
              <option value="networking">Networking</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-group-custom">
            <label>Description</label>
            <textarea name="description" rows="3"
                      class="form-control custom-input"
                      style="padding-left:14px;"
                      placeholder="Brief description of what this resource covers..."></textarea>
          </div>
          <div class="form-group-custom">
            <label>Link URL (optional)</label>
            <input type="text" name="file_url" class="form-control custom-input"
                   style="padding-left:14px;"
                   placeholder="https://link-to-your-resource.com">
          </div>
        </div>
        <div class="modal-footer" style="border-top:1px solid #e2e8f0; padding:16px 24px;">
          <button type="button" class="btn btn-nav-outline" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom px-4">
            <i class="bi bi-plus me-1"></i>Add Resource
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>