<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
<div class="dash-layout">

  <aside class="dash-sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/mentor/dashboard"  class="sidebar-link"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
      <a href="/mentor/requests"   class="sidebar-link"><i class="bi bi-inbox"></i><span>Requests</span></a>
      <a href="/mentor/sessions"   class="sidebar-link"><i class="bi bi-calendar2-check"></i><span>My Sessions</span></a>
      <a href="/mentor/messages"   class="sidebar-link"><i class="bi bi-chat-dots"></i><span>Messages</span></a>
      <a href="/mentor/resources"  class="sidebar-link"><i class="bi bi-folder2-open"></i><span>Resources</span></a>
    </nav>
    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/mentor/profile"  class="sidebar-link active"><i class="bi bi-person-circle"></i><span>My Profile</span></a>
      <a href="/auth/logout"     class="sidebar-link sidebar-danger"><i class="bi bi-box-arrow-left"></i><span>Log Out</span></a>
    </nav>
    <div class="sidebar-user">
      <div class="sidebar-avatar sidebar-avatar-mentor"><%= user.full_name.charAt(0).toUpperCase() %></div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Mentor</div>
      </div>
    </div>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <main class="dash-main">
    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen"><i class="bi bi-list"></i></button>
        <div>
          <h5 class="topbar-title mb-0">My Profile</h5>
          <p class="topbar-sub mb-0">Keep your profile updated so students can find you</p>
        </div>
      </div>
    </div>

    <div class="dash-content">
      <div class="row g-4">

        <div class="col-lg-4">
          <div class="dash-card p-4 text-center">
            <div class="profile-avatar-lg mx-auto mb-3" style="background:linear-gradient(135deg,#c88400,#f0a500)">
              <%= userData.full_name.charAt(0).toUpperCase() %>
            </div>
            <h5 class="fw-bold mb-1"><%= userData.full_name %></h5>
            <p class="text-muted small mb-2"><%= userData.email %></p>
            <span class="badge-status badge-mentor mb-3 d-inline-block">Mentor</span>
            <% if (profile.job_title) { %>
              <p class="text-muted small mb-0">
                <i class="bi bi-briefcase me-1"></i><%= profile.job_title %>
              </p>
            <% } %>
            <% if (profile.company) { %>
              <p class="text-muted small mb-0">
                <i class="bi bi-building me-1"></i><%= profile.company %>
              </p>
            <% } %>
            <% if (profile.industry) { %>
              <p class="text-muted small mb-0 mt-2">
                <span class="mentor-industry-tag"><%= profile.industry %></span>
              </p>
            <% } %>
          </div>
        </div>

        <div class="col-lg-8">
          <div class="dash-card">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Edit Your Information</h6>
            </div>
            <div class="p-4">
              <form action="/mentor/profile" method="POST">
                <div class="row g-3">

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Full Name</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-person input-icon"></i>
                        <input type="text" name="full_name"
                               class="form-control custom-input"
                               value="<%= userData.full_name %>" required>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Job Title</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-briefcase input-icon"></i>
                        <input type="text" name="job_title"
                               class="form-control custom-input"
                               placeholder="e.g. Senior Software Engineer"
                               value="<%= profile.job_title || '' %>">
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Company</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-building input-icon"></i>
                        <input type="text" name="company"
                               class="form-control custom-input"
                               placeholder="e.g. Safaricom"
                               value="<%= profile.company || '' %>">
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Industry</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-diagram-3 input-icon"></i>
                        <select name="industry" class="form-control custom-input">
                          <option value="">Select industry</option>
                          <% ['Technology','Finance','Engineering','Law','Medicine',
                              'Business','Media','Education','Other'].forEach(function(ind) { %>
                            <option value="<%= ind %>"
                              <%= profile.industry === ind ? 'selected' : '' %>>
                              <%= ind %>
                            </option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Years of Experience</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-clock-history input-icon"></i>
                        <input type="number" name="years_experience"
                               class="form-control custom-input"
                               min="0" max="50"
                               placeholder="e.g. 5"
                               value="<%= profile.years_experience || '' %>">
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-group-custom">
                      <label>Available for Mentorship</label>
                      <div class="input-icon-wrap">
                        <i class="bi bi-toggle-on input-icon"></i>
                        <select name="is_available" class="form-control custom-input">
                          <option value="1" <%= profile.is_available ? 'selected' : '' %>>
                            Yes — I am available
                          </option>
                          <option value="0" <%= !profile.is_available ? 'selected' : '' %>>
                            No — Not available right now
                          </option>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="form-group-custom">
                      <label>Areas of Expertise</label>
                      <textarea name="expertise" rows="3"
                                class="form-control custom-input"
                                style="padding-left:14px;"
                                placeholder="e.g. Mobile development, system design, career transitions..."><%= profile.expertise || '' %></textarea>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="form-group-custom">
                      <label>Short Bio</label>
                      <textarea name="bio" rows="3"
                                class="form-control custom-input"
                                style="padding-left:14px;"
                                placeholder="Tell students about your career journey..."><%= userData.bio || '' %></textarea>
                    </div>
                  </div>

                  <div class="col-12">
                    <button type="submit" class="btn btn-primary-custom px-5">
                      <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                  </div>

                </div>
              </form>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>