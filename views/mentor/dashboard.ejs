<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">

<div class="dash-layout">

  <!-- SIDEBAR -->
  <aside class="dash-sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/mentor/dashboard" class="sidebar-link active">
        <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
      </a>
      <a href="/mentor/requests" class="sidebar-link">
        <i class="bi bi-inbox"></i><span>Requests</span>
        <% if (stats.pendingRequests > 0) { %>
          <span class="sidebar-badge"><%= stats.pendingRequests %></span>
        <% } %>
      </a>
      <a href="/mentor/sessions" class="sidebar-link">
        <i class="bi bi-calendar2-check"></i><span>My Sessions</span>
      </a>
      <a href="/mentor/messages" class="sidebar-link">
        <i class="bi bi-chat-dots"></i><span>Messages</span>
        <% if (stats.unreadMessages > 0) { %>
          <span class="sidebar-badge"><%= stats.unreadMessages %></span>
        <% } %>
      </a>
      <a href="/mentor/resources" class="sidebar-link">
        <i class="bi bi-folder2-open"></i><span>Resources</span>
      </a>
    </nav>

    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/mentor/profile" class="sidebar-link">
        <i class="bi bi-person-circle"></i><span>My Profile</span>
      </a>
      <a href="/auth/logout" class="sidebar-link sidebar-danger">
        <i class="bi bi-box-arrow-left"></i><span>Log Out</span>
      </a>
    </nav>

    <div class="sidebar-user">
      <div class="sidebar-avatar sidebar-avatar-mentor">
        <%= user.full_name.charAt(0).toUpperCase() %>
      </div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Mentor</div>
      </div>
    </div>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- MAIN -->
  <main class="dash-main">

    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen">
          <i class="bi bi-list"></i>
        </button>
        <div>
          <h5 class="topbar-title mb-0">Mentor Dashboard</h5>
          <p class="topbar-sub mb-0">
            Good to see you, <strong><%= user.full_name.split(' ')[0] %></strong> 👋
          </p>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/mentor/messages" class="topbar-icon-btn">
          <i class="bi bi-bell"></i>
          <% if (stats.unreadMessages > 0) { %>
            <span class="topbar-dot"></span>
          <% } %>
        </a>
        <div class="topbar-user-chip">
          <div class="topbar-avatar topbar-avatar-mentor">
            <%= user.full_name.charAt(0).toUpperCase() %>
          </div>
          <span class="d-none d-md-inline">
            <%= user.full_name.split(' ')[0] %>
          </span>
        </div>
      </div>
    </div>

    <div class="dash-content">

      <!-- STATS -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
          <div class="stat-card stat-gold">
            <div class="stat-icon"><i class="bi bi-inbox-fill"></i></div>
            <div class="stat-value"><%= stats.pendingRequests %></div>
            <div class="stat-label">Pending Requests</div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-calendar2-check"></i></div>
            <div class="stat-value"><%= stats.upcomingSessions %></div>
            <div class="stat-label">Upcoming Sessions</div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div class="stat-value"><%= stats.activeStudents %></div>
            <div class="stat-label">Active Students</div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="bi bi-chat-dots-fill"></i></div>
            <div class="stat-value"><%= stats.unreadMessages %></div>
            <div class="stat-label">Unread Messages</div>
          </div>
        </div>
      </div>

      <div class="row g-4">

        <!-- PENDING REQUESTS -->
        <div class="col-lg-7">
          <div class="dash-card h-100">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Pending Mentorship Requests</h6>
              <a href="/mentor/requests" class="dash-card-more">View all</a>
            </div>

            <% if (pendingRequests.length === 0) { %>
              <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>No pending requests right now.</p>
              </div>
            <% } else { %>
              <div class="request-list">
                <% pendingRequests.forEach(function(r) { %>
                  <div class="request-item">
                    <div class="d-flex align-items-start gap-3">
                      <div class="tbl-avatar">
                        <%= r.student_name.charAt(0) %>
                      </div>
                      <div class="flex-grow-1">
                        <div class="fw-semibold"><%= r.student_name %></div>
                        <div class="small text-muted">
                          <%= r.course || 'Student' %>
                          <% if (r.university) { %> · <%= r.university %><% } %>
                        </div>
                        <% if (r.message) { %>
                          <p class="request-msg">"<%= r.message %>"</p>
                        <% } %>
                      </div>
                    </div>
                    <div class="request-actions">
                      <form action="/mentor/request/<%= r.id %>/accept" method="POST" style="display:inline">
                        <button type="submit" class="btn-action btn-accept">
                          <i class="bi bi-check-lg me-1"></i>Accept
                        </button>
                      </form>
                      <form action="/mentor/request/<%= r.id %>/decline" method="POST" style="display:inline">
                        <button type="submit" class="btn-action btn-decline">
                          <i class="bi bi-x-lg me-1"></i>Decline
                        </button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- UPCOMING SESSIONS -->
        <div class="col-lg-5">
          <div class="dash-card h-100">
            <div class="dash-card-head">
              <h6 class="dash-card-title">Upcoming Sessions</h6>
              <a href="/mentor/sessions" class="dash-card-more">View all</a>
            </div>

            <% if (sessions.length === 0) { %>
              <div class="empty-state">
                <i class="bi bi-calendar2"></i>
                <p>No upcoming sessions scheduled.</p>
              </div>
            <% } else { %>
              <div class="session-list">
                <% sessions.forEach(function(s) { %>
                  <div class="session-item">
                    <div class="session-date-box">
                      <div class="session-day">
                        <%= new Date(s.session_date).toLocaleDateString('en-GB',{day:'numeric'}) %>
                      </div>
                      <div class="session-mon">
                        <%= new Date(s.session_date).toLocaleDateString('en-GB',{month:'short'}) %>
                      </div>
                    </div>
                    <div class="session-details">
                      <div class="session-name"><%= s.student_name %></div>
                      <div class="session-topic">
                        <%= s.topic || 'General Mentorship' %>
                      </div>
                      <div class="session-time">
                        <i class="bi bi-clock me-1"></i>
                        <%= s.session_time
                              ? s.session_time.toString().slice(0,5)
                              : 'TBD' %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>