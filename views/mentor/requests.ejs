<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
<div class="dash-layout">

  <aside class="dash-sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/" class="d-flex align-items-center gap-2">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text">Elimu<span>Link</span></span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="sidebar-label">Main Menu</div>
    <nav class="sidebar-nav">
      <a href="/mentor/dashboard"  class="sidebar-link"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
      <a href="/mentor/requests"   class="sidebar-link active"><i class="bi bi-inbox"></i><span>Requests</span></a>
      <a href="/mentor/sessions"   class="sidebar-link"><i class="bi bi-calendar2-check"></i><span>My Sessions</span></a>
      <a href="/mentor/messages"   class="sidebar-link"><i class="bi bi-chat-dots"></i><span>Messages</span></a>
      <a href="/mentor/resources"  class="sidebar-link"><i class="bi bi-folder2-open"></i><span>Resources</span></a>
    </nav>
    <div class="sidebar-label mt-3">Account</div>
    <nav class="sidebar-nav">
      <a href="/mentor/profile"  class="sidebar-link"><i class="bi bi-person-circle"></i><span>My Profile</span></a>
      <a href="/auth/logout"     class="sidebar-link sidebar-danger"><i class="bi bi-box-arrow-left"></i><span>Log Out</span></a>
    </nav>
    <div class="sidebar-user">
      <div class="sidebar-avatar sidebar-avatar-mentor"><%= user.full_name.charAt(0).toUpperCase() %></div>
      <div>
        <div class="sidebar-user-name"><%= user.full_name %></div>
        <div class="sidebar-user-role">Mentor</div>
      </div>
    </div>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <main class="dash-main">
    <div class="dash-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="topbar-toggle d-lg-none" id="sidebarOpen"><i class="bi bi-list"></i></button>
        <div>
          <h5 class="topbar-title mb-0">Mentorship Requests</h5>
          <p class="topbar-sub mb-0">Review and respond to student requests</p>
        </div>
      </div>
    </div>

    <div class="dash-content">
      <div class="dash-card">
        <div class="dash-card-head">
          <h6 class="dash-card-title">All Requests</h6>
          <span class="text-muted small"><%= requests.length %> total</span>
        </div>

        <% if (requests.length === 0) { %>
          <div class="empty-state py-5">
            <i class="bi bi-inbox"></i>
            <p>No mentorship requests yet.</p>
          </div>
        <% } else { %>
          <div class="request-list">
            <% requests.forEach(function(r) { %>
              <div class="request-item">
                <div class="d-flex align-items-start gap-3">
                  <div class="tbl-avatar"><%= r.student_name.charAt(0) %></div>
                  <div class="flex-grow-1">
                    <div class="fw-semibold"><%= r.student_name %></div>
                    <div class="small text-muted">
                      <%= r.course || 'Student' %>
                      <% if (r.university) { %> &middot; <%= r.university %><% } %>
                    </div>
                    <% if (r.message) { %>
                      <p class="request-msg">"<%= r.message %>"</p>
                    <% } %>
                    <div class="mt-2">
                      <span class="badge-status badge-<%= r.status %>">
                        <%= r.status.charAt(0).toUpperCase() + r.status.slice(1) %>
                      </span>
                      <span class="text-muted small ms-2">
                        <%= new Date(r.created_at).toLocaleDateString('en-GB',
                            { day:'numeric', month:'short', year:'numeric' }) %>
                      </span>
                    </div>
                  </div>
                </div>
                <% if (r.status === 'pending') { %>
  <div class="request-actions">
    <form action="/mentor/request/<%= r.id %>/accept" method="POST" style="display:inline">
      <button type="submit" class="btn-action btn-accept">
        <i class="bi bi-check-lg me-1"></i>Accept
      </button>
    </form>
    <form action="/mentor/request/<%= r.id %>/decline" method="POST" style="display:inline">
      <button type="submit" class="btn-action btn-decline">
        <i class="bi bi-x-lg me-1"></i>Decline
      </button>
    </form>
  </div>
<% } %>
<% if (r.status === 'accepted') { %>
  <div class="request-actions mt-2">
    <a href="/mentor/sessions/book/<%= r.student_id %>"
       class="btn-action btn-accept">
      <i class="bi bi-calendar-plus me-1"></i>Book a Session
    </a>
  </div>
<% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>