<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- ── NAVBAR ──────────────────────────────── -->
<nav class="navbar navbar-expand-lg fixed-top" id="mainNav">
  <div class="container">

    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
      <span class="logo-text">Elimu<span>Link</span></span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav mx-auto gap-1">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="#how-it-works">How It Works</a></li>
        <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
        <li class="nav-item"><a class="nav-link" href="#universities">Universities</a></li>
      </ul>
      <div class="d-flex align-items-center gap-2">
        <% if (user) { %>
          <a href="/dashboard" class="btn btn-nav-outline">Dashboard</a>
          <a href="/auth/logout" class="btn btn-nav-filled">Log Out</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-nav-outline">Log In</a>
          <a href="/auth/register" class="btn btn-nav-filled">Get Started</a>
        <% } %>
      </div>
    </div>

  </div>
</nav>


<!-- ── HERO ────────────────────────────────── -->
<section class="hero-section">
  <div class="container">
    <div class="row align-items-center py-5" style="min-height:100vh;">

      <!-- Left: Content -->
      <div class="col-lg-6 hero-content">
        <h1 class="hero-title">
          Find a mentor who's <span class="highlight">already walked</span> your path
        </h1>
        <p class="hero-subtitle">
          ElimuLink connects Kenyan university students with alumni and industry professionals for structured, real career guidance. Free for every student. No connections needed to start.
        </p>
        <div class="hero-actions">
          <a href="/auth/register?role=student" class="btn btn-accent btn-lg">
            <i class="bi bi-person-plus me-2"></i>I'm a Student
          </a>
          <a href="/auth/register?role=mentor" class="btn btn-hero-outline btn-lg">
            <i class="bi bi-briefcase me-2"></i>I'm a Mentor
          </a>
        </div>
        <p class="hero-note">
          <i class="bi bi-shield-check me-1"></i>
          Free for all students &middot; No credit card needed
        </p>
      </div>

      <!-- Right: Platform visual (NO FAKE NAMES) -->
      <div class="col-lg-6 d-none d-lg-block">
        <div class="hero-visual-wrap">
          <div class="hv-grid">

            <!-- Stats card -->
            <div class="hv-card">
              <div class="hv-stats-row">
                <div class="hv-stat-block">
                  <div class="hv-stat-num">500+</div>
                  <div class="hv-stat-label">Verified Mentors</div>
                </div>
                <div class="hv-stat-divider"></div>
                <div class="hv-stat-block">
                  <div class="hv-stat-num">15+</div>
                  <div class="hv-stat-label">Industries</div>
                </div>
              </div>
            </div>

            <!-- Session confirmed card -->
            <div class="hv-card">
              <div class="hv-session-card">
                <div class="hv-check-icon">
                  <i class="bi bi-check-lg"></i>
                </div>
                <div>
                  <div class="hv-session-title">Session Booked</div>
                  <div class="hv-session-sub">Career Guidance &middot; 60 min</div>
                </div>
              </div>
            </div>

            <!-- Industry categories card -->
            <div class="hv-card hv-card-wide">
              <div class="hv-cat-title">Find mentors in your field</div>
              <div class="hv-chips">
                <span class="hv-chip"><i class="bi bi-laptop me-1"></i>Technology</span>
                <span class="hv-chip"><i class="bi bi-bank me-1"></i>Finance</span>
                <span class="hv-chip"><i class="bi bi-gear me-1"></i>Engineering</span>
                <span class="hv-chip"><i class="bi bi-briefcase me-1"></i>Business</span>
                <span class="hv-chip"><i class="bi bi-heart-pulse me-1"></i>Medicine</span>
                <span class="hv-chip"><i class="bi bi-mic me-1"></i>Media</span>
              </div>
            </div>

            <!-- Mentors count card -->
            <div class="hv-card hv-count-card">
              <div class="hv-count-big">4</div>
              <div class="hv-count-sub">Partner Universities</div>
            </div>

            <!-- Free badge card -->
            <div class="hv-card hv-free-card">
              <i class="bi bi-shield-check-fill"></i>
              100% Free for Students
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ── STATS BAR ────────────────────────────── -->
<section class="stats-bar">
  <div class="container">
    <div class="row g-4 justify-content-center text-center">
      <div class="col-6 col-md-3">
        <div class="stat-item">
          <div class="stat-number">500+</div>
          <div class="stat-label">Verified Mentors</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-item">
          <div class="stat-number">15+</div>
          <div class="stat-label">Industries Covered</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-item">
          <div class="stat-number">4</div>
          <div class="stat-label">Partner Universities</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-item">
          <div class="stat-number">2,000+</div>
          <div class="stat-label">Students Guided</div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ── FEATURES ──────────────────────────────── -->
<section class="features-section" id="features">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-label">Why ElimuLink</span>
      <h2 class="section-title">Everything you need to launch your career</h2>
      <p class="section-sub">One platform. All the tools. No cost.</p>
    </div>
    <div class="row g-4 mt-3">

      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon icon-green"><i class="bi bi-person-badge"></i></div>
          <h4>Find the Right Mentor</h4>
          <p>Browse verified alumni and professionals filtered by industry and expertise. Everyone here wants to help.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon icon-gold"><i class="bi bi-calendar2-check"></i></div>
          <h4>Book Sessions Easily</h4>
          <p>Schedule one-on-one mentorship sessions directly. See availability, pick a time, and confirm instantly.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon icon-blue"><i class="bi bi-folder2-open"></i></div>
          <h4>Access Career Resources</h4>
          <p>Download free CV templates, interview guides, and industry overviews shared by real professionals.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon icon-purple"><i class="bi bi-chat-dots"></i></div>
          <h4>Stay Connected</h4>
          <p>Message your mentor through a clean built-in messaging system. Every conversation stays organized.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon icon-green"><i class="bi bi-graph-up-arrow"></i></div>
          <h4>Track Your Progress</h4>
          <p>Your personal dashboard shows sessions, bookings, messages, and resources — your full journey in one view.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon icon-gold"><i class="bi bi-shield-lock"></i></div>
          <h4>Safe and Trusted</h4>
          <p>Every mentor is reviewed before joining. Administrators monitor the platform for quality and safety.</p>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ── HOW IT WORKS ──────────────────────────── -->
<section class="how-section" id="how-it-works">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-label">Simple Process</span>
      <h2 class="section-title">Get started in four steps</h2>
      <p class="section-sub">From sign-up to your first mentorship session in under 10 minutes. Click any step to begin.</p>
    </div>
    <div class="row g-4 mt-3">

      <div class="col-md-3">
        <a href="/auth/register?role=student" class="step-card text-decoration-none d-block">
          <div class="step-number">01</div>
          <div class="step-icon"><i class="bi bi-person-plus"></i></div>
          <h5>Create Your Profile</h5>
          <p>Sign up as a student. Tell us your university, course, and career direction.</p>
          <div class="step-cta"><i class="bi bi-arrow-right"></i> Register now</div>
        </a>
      </div>

      <div class="col-md-3">
        <a href="/auth/login" class="step-card text-decoration-none d-block">
          <div class="step-number">02</div>
          <div class="step-icon"><i class="bi bi-search"></i></div>
          <h5>Browse Mentors</h5>
          <p>Explore mentor profiles filtered by industry and expertise. Find your perfect match.</p>
          <div class="step-cta"><i class="bi bi-arrow-right"></i> Find mentors</div>
        </a>
      </div>

      <div class="col-md-3">
        <a href="/auth/register?role=student" class="step-card text-decoration-none d-block">
          <div class="step-number">03</div>
          <div class="step-icon"><i class="bi bi-send"></i></div>
          <h5>Send a Request</h5>
          <p>Introduce yourself and explain what guidance you are looking for. The mentor responds.</p>
          <div class="step-cta"><i class="bi bi-arrow-right"></i> Get started</div>
        </a>
      </div>

      <div class="col-md-3">
        <a href="/auth/register?role=student" class="step-card text-decoration-none d-block">
          <div class="step-number">04</div>
          <div class="step-icon"><i class="bi bi-stars"></i></div>
          <h5>Start Growing</h5>
          <p>Book sessions, message your mentor, and access career resources all in one place.</p>
          <div class="step-cta"><i class="bi bi-arrow-right"></i> Join free</div>
        </a>
      </div>

    </div>
  </div>
</section>


<!-- ── UNIVERSITIES ──────────────────────────── -->
<section class="universities-section" id="universities">
  <div class="container text-center">
    <p class="unis-label">Designed for students at</p>
    <div class="unis-grid">
      <a href="https://www.uonbi.ac.ke" target="_blank" class="uni-tag">
        <i class="bi bi-building"></i>University of Nairobi
      </a>
      <a href="https://www.ku.ac.ke" target="_blank" class="uni-tag">
        <i class="bi bi-building"></i>Kenyatta University
      </a>
      <a href="https://strathmore.edu" target="_blank" class="uni-tag">
        <i class="bi bi-building"></i>Strathmore University
      </a>
      <a href="https://www.usiu.ac.ke" target="_blank" class="uni-tag">
        <i class="bi bi-building"></i>USIU-Africa
      </a>
    </div>
  </div>
</section>


<!-- ── TESTIMONIALS ──────────────────────────── -->
<section class="testimonials-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-label">Student Stories</span>
      <h2 class="section-title">What students are saying</h2>
    </div>
    <div class="row g-4 mt-3 justify-content-center">

      <div class="col-md-4">
        <div class="testimonial-card">
          <div class="quote-icon"><i class="bi bi-quote"></i></div>
          <p class="quote-text">"Before ElimuLink I had no idea what to do after graduation. My mentor helped me understand what skills actually matter in the job market. I got my first job two months after graduating."</p>
          <div class="quote-author">
            <div class="quote-avatar">BW</div>
            <div>
              <div class="quote-name">Brian Waweru</div>
              <div class="quote-uni">BSc Computer Science &middot; UoN</div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="testimonial-card">
          <div class="quote-icon"><i class="bi bi-quote"></i></div>
          <p class="quote-text">"I always thought mentorship was only for people who knew the right people. ElimuLink proved me wrong. It completely changed how I think about my career path."</p>
          <div class="quote-author">
            <div class="quote-avatar av-gold">GN</div>
            <div>
              <div class="quote-name">Grace Njoroge</div>
              <div class="quote-uni">BCom Finance &middot; Kenyatta University</div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="testimonial-card">
          <div class="quote-icon"><i class="bi bi-quote"></i></div>
          <p class="quote-text">"The CV templates and interview guides alone were worth joining. But having a real professional answer my questions was something I never had access to before."</p>
          <div class="quote-author">
            <div class="quote-avatar av-green">DO</div>
            <div>
              <div class="quote-name">David Ochieng</div>
              <div class="quote-uni">BEng Electrical &middot; Strathmore</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ── CTA ───────────────────────────────────── -->
<section class="cta-section">
  <div class="container text-center">
    <h2 class="cta-title">Your career does not have to wait until graduation</h2>
    <p class="cta-sub">Join thousands of Kenyan students already building their professional futures through ElimuLink.</p>
    <div class="cta-buttons">
      <a href="/auth/register?role=student" class="btn btn-cta-white btn-lg">
        <i class="bi bi-person-plus me-2"></i>Join as a Student
      </a>
      <a href="/auth/register?role=mentor" class="btn btn-cta-outline btn-lg">
        <i class="bi bi-briefcase me-2"></i>Become a Mentor
      </a>
    </div>
  </div>
</section>


<!-- ── FOOTER ────────────────────────────────── -->
<footer class="site-footer">
  <div class="container">
    <div class="row g-4">

      <!-- Brand -->
      <div class="col-lg-4">
        <div class="d-flex align-items-center gap-2 mb-3">
          <div class="logo-icon logo-icon-sm"><i class="bi bi-mortarboard-fill"></i></div>
          <span class="logo-text text-white">Elimu<span style="color:#2d8a6b">Link</span></span>
        </div>
        <p class="footer-desc">
          Connecting Kenyan university students with professionals for structured, accessible career mentorship.
        </p>
        <div class="mt-3">
          <span class="sdg-badge">SDG 4</span>
          <span class="sdg-badge">SDG 8</span>
          <span class="sdg-badge">SDG 10</span>
        </div>
      </div>

      <!-- Platform links -->
      <div class="col-lg-2 col-6">
        <h6 class="footer-heading">Platform</h6>
        <ul class="footer-links">
          <li><a href="/"><i class="bi bi-house me-1"></i>Home</a></li>
          <li><a href="/auth/register?role=student"><i class="bi bi-mortarboard me-1"></i>Join as Student</a></li>
          <li><a href="/auth/register?role=mentor"><i class="bi bi-briefcase me-1"></i>Become a Mentor</a></li>
          <li><a href="/auth/login"><i class="bi bi-box-arrow-in-right me-1"></i>Log In</a></li>
          <li><a href="#features"><i class="bi bi-info-circle me-1"></i>Features</a></li>
          <li><a href="#how-it-works"><i class="bi bi-question-circle me-1"></i>How It Works</a></li>
        </ul>
      </div>

      <!-- Universities -->
      <div class="col-lg-3 col-6">
        <h6 class="footer-heading">Partner Universities</h6>
        <ul class="footer-links">
          <li><a href="https://www.uonbi.ac.ke" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i>University of Nairobi</a></li>
          <li><a href="https://www.ku.ac.ke" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i>Kenyatta University</a></li>
          <li><a href="https://strathmore.edu" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i>Strathmore University</a></li>
          <li><a href="https://www.usiu.ac.ke" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i>USIU-Africa</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="col-lg-3">
        <h6 class="footer-heading">Contact</h6>
        <ul class="footer-links">
          <li><a href="mailto:hello@elimulink.co.ke"><i class="bi bi-envelope me-2"></i>hello@elimulink.co.ke</a></li>
          <li><span><i class="bi bi-geo-alt me-2"></i>Nairobi, Kenya</span></li>
        </ul>
        <div class="social-links mt-3">
          <a href="https://linkedin.com" target="_blank" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
          <a href="https://twitter.com" target="_blank" title="X (Twitter)"><i class="bi bi-twitter-x"></i></a>
          <a href="https://instagram.com" target="_blank" title="Instagram"><i class="bi bi-instagram"></i></a>
        </div>
      </div>

    </div>

    <hr class="footer-divider">

    <div class="footer-bottom">
      <span>&copy; 2025 ElimuLink. All rights reserved.</span>
      <span>Built for Kenyan Students 🇰🇪</span>
    </div>

  </div>
</footer>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>