<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">

<div class="auth-wrapper">

  <!-- Left panel -->
  <div class="auth-left d-none d-lg-flex">
    <div class="auth-left-inner">
      <a href="/" class="d-flex align-items-center gap-2 mb-5">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="logo-text text-white">Elimu<span style="color:#f0a500">Link</span></span>
      </a>
      <h2 class="auth-left-title">Welcome back. Your mentor is waiting.</h2>
      <p class="auth-left-sub">Log in to manage your sessions, continue conversations, and keep building your career.</p>
      <div class="auth-left-stats">
        <div class="auth-stat"><span>500+</span><p>Mentors Available</p></div>
        <div class="auth-stat"><span>2,000+</span><p>Students Guided</p></div>
      </div>
    </div>
  </div>

  <!-- Right panel — form -->
  <div class="auth-right">
    <div class="auth-form-wrap">

      <div class="d-lg-none mb-4 text-center">
        <a href="/" class="d-inline-flex align-items-center gap-2">
          <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
          <span class="logo-text">Elimu<span>Link</span></span>
        </a>
      </div>

      <h3 class="auth-title">Log In</h3>
      <p class="auth-sub">Don't have an account? <a href="/auth/register">Create one free</a></p>

      <% if (error) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
          <i class="bi bi-exclamation-circle-fill"></i>
          <%= error %>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" novalidate>

        <div class="form-group-custom">
          <label>Email Address</label>
          <div class="input-icon-wrap">
            <i class="bi bi-envelope input-icon"></i>
            <input type="email" name="email" class="form-control custom-input"
                   placeholder="you@university.ac.ke" required>
          </div>
        </div>

        <div class="form-group-custom">
          <label>Password</label>
          <div class="input-icon-wrap">
            <i class="bi bi-lock input-icon"></i>
            <input type="password" name="password" id="passwordField"
                   class="form-control custom-input" placeholder="Your password" required>
            <button type="button" class="toggle-password" onclick="togglePassword()">
              <i class="bi bi-eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary-custom w-100 mt-2">
          <i class="bi bi-box-arrow-in-right me-2"></i>Log In
        </button>

      </form>

      <p class="auth-switch mt-4 text-center">
        Not registered yet? <a href="/auth/register">Join ElimuLink free</a>
      </p>

    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function togglePassword() {
    const field = document.getElementById('passwordField');
    const icon  = document.getElementById('eyeIcon');
    if (field.type === 'password') {
      field.type = 'text';
      icon.className = 'bi bi-eye-slash';
    } else {
      field.type = 'password';
      icon.className = 'bi bi-eye';
    }
  }
</script>
</body>
</html>